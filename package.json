{
  "name": "cospec-telemetry-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist/",
    "contracts/",
    "README.md"
  ],
  "bin": {
    "cospec-telemetry": "./dist/collector/cli.js",
    "cospec-telemetry-server": "./dist/server/cli.js",
    "cospec-telemetry-replay": "./dist/server/replay-cli.js"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && npm run web:build",
    "build:package": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.pack.json && npm run web:build",
    "build:collector-bundle": "npm run build:package && esbuild dist/collector/cli.js --bundle --platform=node --format=esm --target=node24 --outfile=dist/cospec-collector.mjs && node --check dist/cospec-collector.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/**/*.test.js && npm run web:test",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:test": "vitest run --config web/vite.config.ts",
    "test:e2e": "playwright test --config web/playwright.config.ts",
    "prepack": "npm run build:package",
    "server": "node dist/server/cli.js",
    "replay": "node dist/server/replay-cli.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@tanstack/vue-query": "^5.102.8",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.5",
    "fastify": "^5.12.1",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4"
  }
}
